# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Perceptron (https://platform.perceptron.inc). Without a key, photos are still
# saved but food is not recognized automatically.
PERCEPTRON_API_KEY=
# PERCEPTRON_MODEL=perceptron-mk1.5
# Reasoning before answering: none (fastest, ~1 s per photo), low, medium, high.
# PERCEPTRON_REASONING=none

# The inventory is stored in a local SQLite file by default; nothing to set up.
# SQLITE_PATH=data/shelfsense.db

# Optional: use MongoDB instead, e.g. a free Atlas M0 cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
# MONGODB_DB=shelfsense
